{
  "name": "mild_contradiction_lowers_confidence",
  "description": "One weak contradicting item lowers confidence but does not destroy the belief.",
  "steps": [
    {"op": "evidence", "id": "s1", "belief": "adherence", "direction": "support", "strength": 0.9, "source_type": "recorded_event", "days_before_as_of": 12},
    {"op": "evidence", "id": "s2", "belief": "adherence", "direction": "support", "strength": 0.9, "source_type": "explicit_user_statement", "days_before_as_of": 11},
    {"op": "evidence", "id": "s3", "belief": "adherence", "direction": "support", "strength": 0.9, "source_type": "model_observation", "days_before_as_of": 10},
    {"op": "recompute", "belief": "adherence", "belief_key": "higher_adherence_after_work", "belief_value": true, "checkpoint": "supported"},

    {"op": "evidence", "id": "c1", "belief": "adherence", "direction": "contradict", "strength": 0.25, "source_type": "unverified_hypothesis", "days_before_as_of": 4},
    {"op": "recompute", "belief": "adherence", "belief_key": "higher_adherence_after_work", "belief_value": true, "checkpoint": "after_mild_contradiction"}
  ],
  "expect": [
    {"check": "belief_confidence", "belief": "adherence", "lt_checkpoint": "supported"},
    {"check": "belief_confidence", "belief": "adherence", "min": 0.25},
    {"check": "belief_field", "belief": "adherence", "field": "supporting_evidence_count", "equals": 3},
    {"check": "belief_field", "belief": "adherence", "field": "contradicting_evidence_count", "equals": 1},
    {"check": "belief_status", "belief": "adherence", "in": ["provisional", "validated"]},
    {"check": "belief_locked", "belief": "adherence", "equals": false}
  ]
}
